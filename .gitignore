.eggs/

# Personal files
TASKS.md
MEMORY.md
.claude/worktrees/

# Cron and operational logs (content gitignored; directory tracked via .gitkeep)
logs/*.log
tmp/
.claude/settings.local.json

# News-digest runtime state (ledger + FactSet result cache + verdict cache — regenerated each run)
state/news_digest_seen.jsonl
state/factset_cache/
state/factset_cache_dryrun/
state/news_verdict_cache_*.json
logs/news_digest_*.txt
# v3 news-flow brief section for combine_and_send (ephemeral daily)
logs/report_news_*.txt

# Chunk store — embeddings + caches + DERIVED metrics are regenerable; ignore the
# dir's contents but TRACK state/chunk_store/factset_raw/ (Store B source-of-truth:
# the FactSet guidance+surprise pulls, not regenerable without MCP access).
state/chunk_store/*
!state/chunk_store/factset_raw/
# (metrics.jsonl / credibility.json are direct children of chunk_store/, so they stay
#  ignored by the `*` rule above — derived from factset_raw via ingest_metrics.py)

# v3 ingest runtime state (watermark — regenerable via DB rescan)
state/v3_ingest/

# Transcript ingest (P1) — bulk retrieved chunks, the resume ledger and the raw
# FactSet payload cache. Regenerable by re-running transcript_ingest.py, and far
# too large for git (a full 9-month backfill is ~10^5 rows). The small
# _no_coverage.json IS tracked: it is the documented exclusion list every
# downstream figure has to print. The {TICKER}.json earnings-reviewer ledgers
# already in this directory stay tracked too.
state/transcripts/exchanges.jsonl
state/transcripts/_progress.json
state/transcripts/raw/

# Evidence side (P3b) and the shared topic vocabulary (P2). Same reasoning as
# above: bulk regenerable output, rebuilt by mdna_evidence.py / topic_map.py.
# _candidates.json is the operator review queue — regenerated every run, so it
# is working state rather than a record. auto_sync.py commits anything left
# untracked here every 15 minutes, which is why these need to be listed before
# either script is run for real.
state/evidence/
state/topics/

# Obsidian per-device workspace state (don't sync between devices)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace-tablet.json
.obsidian/cache
.obsidian/.cache

# Prevent future iPad/Obsidian noise from being committed
.obsidian/plugins/
.obsidian/community-plugins.json
.obsidian/graph.json
Untitled*.md
Untitled*.canvas
Untitled*.base

.obsidian/
